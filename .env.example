# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=astra_super_secret_jwt_key_mission_control_2026

# NASA NeoWs API Key (Get a free key from https://api.nasa.gov or leave DEMO_KEY for initial testing)
NASA_API_KEY=DEMO_KEY

# MongoDB Connection String (Leave empty or set to your local/Atlas URI; graceful mock fallback is automatic if unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/astra_db

# Risk Scoring Model Weights (Normalized out of 100)
RISK_WEIGHT_MISS_DISTANCE=30
RISK_WEIGHT_DIAMETER=25
RISK_WEIGHT_VELOCITY=20
RISK_WEIGHT_HAZARDOUS=25
